# ==============================================================================
# ZSH VI MODE PLUGIN CONFIGURATION (~/.zsh_vim)
# ==============================================================================

# Configure cursor style handling
ZVM_CURSOR_STYLE_ENABLED=true
ZVM_KEYTIMEOUT=0.01

# Custom initialisation hook for keybindings and tmux integration
function zvm_after_init() {
  # 1. Custom 'jk' escape sequence for insert mode
  zvm_bindkey viins 'jk' zvm_exit_insert_mode

  # 2. Re-bind Ctrl+R for fzf in both modes
  if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
    source /usr/share/doc/fzf/examples/key-bindings.zsh
    source /usr/share/doc/fzf/examples/completion.zsh
    zvm_bindkey viins '^R' fzf-history-widget
    zvm_bindkey vicmd '^R' fzf-history-widget
  fi

  # 3. Substring search on 'k' and 'j' in normal mode
  if (( $+widgets[history-substring-search-up] )); then
    zvm_bindkey vicmd 'k' history-substring-search-up
    zvm_bindkey vicmd 'j' history-substring-search-down
  fi
}

# Hook mode changes to update the Tmux status bar
function zvm_after_select_vi_mode() {
  if [[ -n "$TMUX" ]]; then
    case $ZVM_MODE in
      $ZVM_MODE_NORMAL)
        tmux set-option -q @vi_mode "#[fg=red,bold][NORMAL]#[default]"
        ;;
      $ZVM_MODE_INSERT)
        tmux set-option -q @vi_mode "#[fg=green,bold][INSERT]#[default]"
        ;;
    esac
    tmux refresh-client -S
  fi
}
